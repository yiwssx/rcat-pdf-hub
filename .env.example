# Copy to .env and replace every CHANGE_ME value before first start.
POSTGRES_DB=pdfhub
POSTGRES_USER=pdfhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Use at least 32 random bytes. Changing this invalidates all stored service API keys.
PDFHUB_API_KEY_PEPPER=CHANGE_ME_RANDOM_64_HEX

# Bootstrap administrator key. Keep private; use it only to create scoped service keys.
PDFHUB_ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_ADMIN_KEY

# Master key used to derive a different webhook signing secret for each service.
PDFHUB_WEBHOOK_MASTER_SECRET=CHANGE_ME_RANDOM_WEBHOOK_MASTER_SECRET
# Comma-separated exact hosts or wildcard suffixes, e.g. sis.internal.example.org,*.internal.example.org
# Keep empty to disable outbound webhooks.
PDFHUB_WEBHOOK_ALLOWED_HOSTS=

PDFHUB_HTTP_PORT=8080
PDFHUB_MAX_UPLOAD_MB=100
PDFHUB_RETENTION_HOURS=24
PDFHUB_CLEANUP_INTERVAL_SECONDS=900
PDFHUB_CLEANUP_TEMPORARY_HOURS=6
PDFHUB_PREVIEW_MAX_WIDTH=1600
PDFHUB_DEFAULT_RATE_LIMIT_PER_MINUTE=120
PDFHUB_DEFAULT_DAILY_JOB_LIMIT=1000
PDFHUB_DEFAULT_MAX_STORAGE_MB=2048
PDFHUB_ALLOWED_ORIGINS=http://localhost:8080
