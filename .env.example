POSTGRES_DB=pdfhub
POSTGRES_USER=pdfhub
POSTGRES_PASSWORD=replace-with-a-long-random-password

PDFHUB_API_KEY_PEPPER=replace-with-a-long-random-pepper
PDFHUB_ADMIN_API_KEY=pdfh_replace-with-a-long-random-admin-key
PDFHUB_WEBHOOK_MASTER_SECRET=replace-with-a-long-random-webhook-master-secret
PDFHUB_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
PDFHUB_DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-bytes

PDFHUB_WEBHOOK_ALLOWED_HOSTS=
PDFHUB_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
PDFHUB_WEBHOOK_TIMEOUT_SECONDS=10
PDFHUB_WEBHOOK_MAX_ATTEMPTS=6
PDFHUB_WEBHOOK_RETRY_INITIAL_SECONDS=5
PDFHUB_WEBHOOK_RETRY_MAX_SECONDS=900
PDFHUB_WEBHOOK_DISPATCH_INTERVAL_SECONDS=2
PDFHUB_WEBHOOK_DISPATCH_BATCH_SIZE=50
PDFHUB_ALLOWED_ORIGINS=http://localhost:8080
PDFHUB_PUBLIC_BASE_URL=http://localhost:8080
PDFHUB_SIGNED_DOWNLOAD_DEFAULT_TTL_SECONDS=300
PDFHUB_SIGNED_DOWNLOAD_MAX_TTL_SECONDS=3600
PDFHUB_HTTP_PORT=8080
PDFHUB_MANAGEMENT_BIND_HOST=127.0.0.1
PDFHUB_SESSION_COOKIE_SECURE=false
PDFHUB_SESSION_TTL_MINUTES=480
PDFHUB_ADMIN_GROUPS=pdfhub-admins

PDFHUB_MAX_UPLOAD_MB=100
PDFHUB_RETENTION_HOURS=24
PDFHUB_CLEANUP_INTERVAL_SECONDS=900
PDFHUB_CLEANUP_TEMPORARY_HOURS=6
PDFHUB_PREVIEW_MAX_WIDTH=1600
PDFHUB_PDF_TO_IMAGE_MAX_PAGES=200
PDFHUB_DEFAULT_RATE_LIMIT_PER_MINUTE=120
PDFHUB_DEFAULT_DAILY_JOB_LIMIT=1000
PDFHUB_DEFAULT_MAX_STORAGE_MB=2048
PDFHUB_RQ_QUEUE=pdf
PDFHUB_RQ_JOB_TIMEOUT_SECONDS=1800

# OIDC / SSO. Use an existing institutional IdP or a free self-hosted IdP such as Keycloak or Authentik.
PDFHUB_OIDC_ENABLED=false
PDFHUB_OIDC_ISSUER=
PDFHUB_OIDC_CLIENT_ID=
PDFHUB_OIDC_CLIENT_SECRET=
PDFHUB_OIDC_AUDIENCE=
PDFHUB_OIDC_DISCOVERY_URL=
PDFHUB_OIDC_GROUP_CLAIM=groups

# LDAP / Active Directory direct login. Prefer LDAPS in production.
PDFHUB_LDAP_ENABLED=false
PDFHUB_LDAP_URL=ldaps://ldap.example.org:636
PDFHUB_LDAP_BASE_DN=ou=People,dc=example,dc=org
PDFHUB_LDAP_BIND_DN=
PDFHUB_LDAP_BIND_PASSWORD=
PDFHUB_LDAP_USER_FILTER=(uid={username})
PDFHUB_LDAP_USER_DN_TEMPLATE=
PDFHUB_LDAP_GROUP_BASE_DN=ou=Groups,dc=example,dc=org
PDFHUB_LDAP_GROUP_FILTER=(member={user_dn})

# Storage: local also supports a NAS mounted at /data using docker-compose.nas.yml.
PDFHUB_STORAGE_BACKEND=local
PDFHUB_NAS_PATH=/srv/pdfhub-data

# S3-compatible storage must use an explicit self-hosted endpoint such as bundled SeaweedFS or Ceph RGW.
# The application refuses S3 mode without PDFHUB_S3_ENDPOINT_URL so it cannot silently fall back to a paid cloud endpoint.
PDFHUB_S3_ENDPOINT_URL=
PDFHUB_S3_REGION=us-east-1
PDFHUB_S3_BUCKET=pdfhub
PDFHUB_S3_ACCESS_KEY=
PDFHUB_S3_SECRET_KEY=
PDFHUB_S3_PREFIX=pdfhub
PDFHUB_S3_ADDRESSING_STYLE=path
PDFHUB_S3_AUTO_CREATE_BUCKET=false
PDFHUB_S3_SERVER_SIDE_ENCRYPTION=

# Optional ClamAV. Start with: docker compose --profile security up -d clamav
PDFHUB_CLAMAV_ENABLED=false
PDFHUB_CLAMAV_HOST=clamav
PDFHUB_CLAMAV_PORT=3310
PDFHUB_CLAMAV_FAIL_CLOSED=true

# Management ports default to loopback. Change PDFHUB_MANAGEMENT_BIND_HOST only for a trusted management network.
# Observability remains self-hosted. The bundled collector can send traces to a local Jaeger/Tempo-compatible endpoint.
PDFHUB_PROMETHEUS_ENABLED=true
PDFHUB_PROMETHEUS_PORT=9090
PDFHUB_OTEL_ENDPOINT=
PDFHUB_OTEL_SERVICE_NAME=rcat-pdf-hub-api
PDFHUB_OTEL_GRPC_PORT=4317
PDFHUB_OTEL_HTTP_PORT=4318

# Paperless-ngx downstream archive is bundled as an optional self-hosted profile.
PDFHUB_PAPERLESS_ENABLED=false
PDFHUB_PAPERLESS_URL=http://paperless:8000
PDFHUB_PAPERLESS_TOKEN=
PDFHUB_PAPERLESS_AUTO_ARCHIVE=false
PAPERLESS_DB_PASSWORD=replace-with-a-long-random-password
PAPERLESS_SECRET_KEY=replace-with-a-long-random-secret
PAPERLESS_URL=http://localhost:8001
PAPERLESS_HTTP_PORT=8001